/**
 * @file Firestore Security Rules for SmartVest Platform
 * @corePhilosophy This ruleset enforces a strict user-ownership model for personal data while allowing public read access to investment packages. Administrative privileges are controlled via the `isAdmin` field on user documents.
 * @dataStructure
 *   - /users/{userId}: User profiles, including an `isAdmin` flag.
 *   - /packages/{packageId}: Investment packages (publicly readable).
 *   - /users/{userId}/userPackages/{userPackageId}: Packages purchased by a user.
 *   - /users/{userId}/wallets/{walletId}: User's wallet.
 *   - /users/{userId}/wallets/{walletId}/transactions/{transactionId}: Transactions for a specific wallet.
 *   - /users/{userId}/withdrawalRequests/{withdrawalRequestId}: Withdrawal requests made by a user.
 * @keySecurityDecisions
 *   - Users cannot list all users. Only individual user documents are accessible.
 *   - Packages are publicly readable but only writable by admins (controlled via the `isAdmin` flag in user documents).
 *   - All user-owned data is nested under the /users/{userId} path to enforce ownership.
 *   - Read-only collections are not used in this version.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (get) Authenticated user can read their own profile.
     * @allow (create) Authenticated user can create their own profile, but only if the userId matches their auth.uid.
     * @allow (update) Authenticated user can update their own profile, but only if they own it.
     * @allow (delete) Authenticated user can delete their own profile, but only if they own it.
     * @deny (get) Authenticated user cannot read another user's profile.
     * @deny (list) No one can list all users.
     * @deny (create) An unauthenticated user cannot create a profile.
     * @deny (update) Authenticated user cannot update another user's profile.
     * @deny (delete) Authenticated user cannot delete another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      // Helper function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is the owner of the document
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Helper function to check if the user is the existing owner of the document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to investment packages.
     * @path /packages/{packageId}
     * @allow (get) Any user can read a package.
     * @allow (list) Any user can list packages.
     * @allow (create) Only admins can create packages.
     * @allow (update) Only admins can update packages.
     * @allow (delete) Only admins can delete packages.
     * @deny (create) A non-admin user cannot create a package.
     * @deny (update) A non-admin user cannot update a package.
     * @deny (delete) A non-admin user cannot delete a package.
     * @principle Allows public read access with admin-only writes.
     */
    match /packages/{packageId} {
      // Helper function to check if the user is an admin
      function isAdmin() {
        return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Controls access to user-specific packages.
     * @path /users/{userId}/userPackages/{userPackageId}
     * @allow (get) The owner can get their user package.
     * @allow (list) The owner can list their user packages.
     * @allow (create) The owner can create user package, but only if the userId matches their auth.uid.
     * @allow (update) The owner can update their user package, but only if they own it.
     * @allow (delete) The owner can delete their user package, but only if they own it.
     * @deny (get) Another user cannot read this user package.
     * @deny (create) An unauthenticated user cannot create a user package.
     * @deny (update) Another user cannot update this user package.
     * @deny (delete) Another user cannot delete this user package.
     * @principle Enforces document ownership for writes within a user's data tree.
     */
    match /users/{userId}/userPackages/{userPackageId} {
      // Reuse the isOwner function from the /users/{userId} match
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

     // Helper function to check if the user is the existing owner of the document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to user wallets.
     * @path /users/{userId}/wallets/{walletId}
     * @allow (get) The owner can get their wallet.
     * @allow (list) The owner can list their wallets.
     * @allow (create) The owner can create a wallet, but only if the userId matches their auth.uid.
     * @allow (update) The owner can update their wallet, but only if they own it.
     * @allow (delete) The owner can delete their wallet, but only if they own it.
     * @deny (get) Another user cannot read this wallet.
     * @deny (create) An unauthenticated user cannot create a wallet.
     * @deny (update) Another user cannot update this wallet.
     * @deny (delete) Another user cannot delete this wallet.
     * @principle Enforces document ownership for writes within a user's data tree.
     */
    match /users/{userId}/wallets/{walletId} {
      // Reuse the isOwner function from the /users/{userId} match
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is the existing owner of the document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to transactions within a user's wallet.
     * @path /users/{userId}/wallets/{walletId}/transactions/{transactionId}
     * @allow (get) The owner can get their transaction.
     * @allow (list) The owner can list their transactions.
     * @allow (create) The owner can create transaction, but only if the wallet is owned by the user.
     * @allow (update) The owner can update their transaction, but only if they own it.
     * @allow (delete) The owner can delete their transaction, but only if they own it.
     * @deny (get) Another user cannot read this transaction.
     * @deny (create) An unauthenticated user cannot create a transaction.
     * @deny (update) Another user cannot update this transaction.
     * @deny (delete) Another user cannot delete this transaction.
     * @principle Enforces document ownership for writes within a user's data tree.
     */
    match /users/{userId}/wallets/{walletId}/transactions/{transactionId} {
      // Reuse the isOwner function from the /users/{userId} match
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is the existing owner of the document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to withdrawal requests.
     * @path /users/{userId}/withdrawalRequests/{withdrawalRequestId}
     * @allow (get) The owner can get their withdrawal request.
     * @allow (list) The owner can list their withdrawal requests.
     * @allow (create) The owner can create a withdrawal request, but only if the userId matches their auth.uid.
     * @allow (update) The owner can update their withdrawal request, but only if they own it.
     * @allow (delete) The owner can delete their withdrawal request, but only if they own it.
     * @deny (get) Another user cannot read this withdrawal request.
     * @deny (create) An unauthenticated user cannot create a withdrawal request.
     * @deny (update) Another user cannot update this withdrawal request.
     * @deny (delete) Another user cannot delete this withdrawal request.
     * @principle Enforces document ownership for writes within a user's data tree.
     */
    match /users/{userId}/withdrawalRequests/{withdrawalRequestId} {
      // Reuse the isOwner function from the /users/{userId} match
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the user is the existing owner of the document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}